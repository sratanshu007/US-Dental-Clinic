NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://dental:CHANGE_ME@db:5432/dental
DATABASE_SSL=false            # true for managed Postgres (RDS etc.)

# openssl rand -hex 32
JWT_SECRET=CHANGE_ME_LONG_RANDOM
# openssl rand -hex 32   (64 hex chars) — encrypts transcripts, notes, feedback, SMS bodies. Back it up safely!
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
# Shared secret with the voice agent (same value in voice/.env)
INTERNAL_API_KEY=CHANGE_ME_LONG_RANDOM

# Public URL of this API (Plivo SMS webhooks + signature check)
PUBLIC_API_URL=https://api.example.com
# Web admin origin(s), comma separated
CORS_ORIGINS=https://app.example.com
# Where the API reaches the voice agent to start outbound calls
VOICE_AGENT_URL=http://voice:7860

PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# Transport-only mode (default on): Plivo does not store SMS text in its logs
PLIVO_REDACT_SMS=true
# Base URL for secure patient links sent by SMS (own short domain pointing at this API)
PATIENT_LINK_BASE=https://dd-care.com

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
JOBS_ENABLED=true
# DRY_RUN=true  -> log SMS/outbound calls instead of sending (also automatic when PLIVO_AUTH_ID is empty)

# ---------- Open Dental sync (Growth/Pro) ----------
# Our developer key from Open Dental's Developer Portal (email vendor.relations@opendental.com).
# Each office creates its own customer key in Open Dental (Setup > Advanced Setup > API) and enters it in Settings.
OPEN_DENTAL_DEVELOPER_KEY=
OPEN_DENTAL_API_URL=https://api.opendental.com/api/v1

# ---------- Billing (Stripe) — optional; without it clinics are billed manually ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SETUP_STANDARD=
STRIPE_PRICE_SETUP_PREMIUM=
WEB_APP_URL=https://app.example.com

# ---------- Alerts ----------
# Slack / Discord incoming webhook for job failures, 500 errors, crashes, failed payments. No patient data is sent.
ALERT_WEBHOOK_URL=

# ---------- Security ----------
# In production the API refuses to start with weak/reused secrets, non-https CORS/URLs, DB without TLS, etc.
# Super admins must turn on 2FA before admin pages work (default true in production)
REQUIRE_ADMIN_MFA=true
# Lock an account for LOCKOUT_MINUTES after MAX_FAILED_LOGINS wrong passwords
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Requests per minute per IP for the dashboard/app API
API_RATE_LIMIT=600
# Optional: only accept /internal calls from these IPs (the voice container), comma-separated
INTERNAL_ALLOWED_IPS=
