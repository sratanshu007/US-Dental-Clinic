NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://dental:CHANGE_ME@db:5432/dental
DATABASE_SSL=false            # true for managed Postgres (RDS etc.)

# openssl rand -hex 32
JWT_SECRET=CHANGE_ME_LONG_RANDOM
# openssl rand -hex 32   (64 hex chars) — encrypts transcripts, notes, feedback, SMS bodies. Back it up safely!
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
# Shared secret with the voice agent (same value in voice/.env)
INTERNAL_API_KEY=CHANGE_ME_LONG_RANDOM

# Public URL of this API (Plivo SMS webhooks + signature check)
PUBLIC_API_URL=https://api.example.com
# Web admin origin(s), comma separated
CORS_ORIGINS=https://app.example.com
# Where the API reaches the voice agent to start outbound calls
VOICE_AGENT_URL=http://voice:7860

PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# Transport-only mode (default on): Plivo does not store SMS text in its logs
PLIVO_REDACT_SMS=true
# Base URL for secure patient links sent by SMS (own short domain pointing at this API)
PATIENT_LINK_BASE=https://dd-care.com

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
JOBS_ENABLED=true
# DRY_RUN=true  -> log SMS/outbound calls instead of sending (also automatic when PLIVO_AUTH_ID is empty)

# ----------------- Login Credentials & Clinic Settings -----------------
# Super Admin Login
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=SetYourStrongAdminPasswordHere

# Clinic Owner Login
OWNER_EMAIL=owner@your-clinic.com
OWNER_PASSWORD=SetYourStrongOwnerPasswordHere

# Clinic Information
CLINIC_NAME=Your Dental Clinic
CLINIC_PHONE=+12105550100
CLINIC_TRANSFER_PHONE=+12105550199
CLINIC_TIMEZONE=America/Chicago
CLINIC_ADDRESS=123 Main St, City, State
