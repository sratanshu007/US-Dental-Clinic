# Public HTTPS URL of this voice service (Plivo must reach it). Use ngrok for local testing.
PUBLIC_URL=https://voice.example.com
PORT=7860

# Node API
API_URL=http://localhost:4000
INTERNAL_API_KEY=change-me-same-as-api

# Plivo
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
VERIFY_PLIVO_SIGNATURE=true

# ----------------- LLM (Groq & OpenAI with Fallback) -----------------
# Primary provider: "groq" (fast, free tier) or "openai"
LLM_PROVIDER=groq

# Free Groq API Key (get from https://console.groq.com/keys)
GROQ_API_KEY=
# Fallback models in priority order (if primary fails, next one runs immediately)
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant,mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (optional fallback if all Groq models fail, or primary if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
SUMMARY_MODEL=llama-3.1-8b-instant

# ----------------- Speech-to-Text (STT) -----------------
# Deepgram STT
DEEPGRAM_API_KEY=

# ----------------- Text-to-Speech (TTS with Fallback) -----------------
# Primary TTS provider: "edge" (free Microsoft Edge TTS), "elevenlabs", "deepgram", or "cartesia"
TTS_PROVIDER=edge

# Fallback sequence: if primary fails (e.g. rate limit, quota, network), fallback runs next
TTS_FALLBACK_PROVIDERS=edge,elevenlabs,deepgram,cartesia

# Microsoft Edge TTS (100% Free, NO API key required, high quality neural voice)
# Popular voices: en-US-JennyNeural, en-US-AriaNeural, en-US-GuyNeural, en-US-ChristopherNeural
EDGE_TTS_VOICE=en-US-JennyNeural

# ElevenLabs TTS (optional ultra-realistic voice)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Deepgram Aura TTS
DEEPGRAM_VOICE=aura-2-thalia-en

# Cartesia Sonic TTS
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

MAX_CALL_SECONDS=900
