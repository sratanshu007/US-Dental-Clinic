# Public HTTPS URL of THIS service (Plivo calls it), e.g. https://voice.yourdomain.com
PUBLIC_URL=https://voice.yourdomain.com
PORT=7860
NODE_ENV=production

# Node API (internal network) + the shared internal key (same value as api/.env)
API_URL=http://api:4000
INTERNAL_API_KEY=

# Plivo — transport only: no recording, no Plivo transcription, SMS content redacted
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
VERIFY_PLIVO_SIGNATURE=true

# Speech-to-text + text-to-speech: Deepgram (BAA required). mip_opt_out is always sent.
# Do NOT use Edge TTS / other free voices for real calls: no contract, no BAA.
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_VOICE=aura-2-thalia-en
# ---- Speed / natural conversation ----
# Silence that ends the caller's turn (ms). Lower = snappier, higher = fewer interruptions.
ENDPOINTING_MS=300
# Extra wait when the caller sounds mid-sentence ("my name is...", "um", "and")
INCOMPLETE_WAIT_MS=700
# If the reply hasn't started after this long, say a quick "Mm-hmm." (0 = off)
THINKING_ACK_MS=900
# Short replies are faster and sound more human on the phone
LLM_MAX_TOKENS=180
LLM_TEMPERATURE=0.6

# LLM — needs a signed BAA + zero data retention before real patient calls.
# LLM_PROVIDER=openai | xai | custom (custom: set OPENAI_BASE_URL, e.g. Azure OpenAI)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# For Grok: LLM_PROVIDER=xai, XAI_API_KEY=..., OPENAI_MODEL=<model name from console.x.ai>
XAI_API_KEY=
SUMMARY_MODEL=

MAX_CALL_SECONDS=900
# info in production. Logs never contain what callers say, names or phone numbers.
LOG_LEVEL=info
